# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# Used by the site chat assistant (OpenRouter).
# Get a key at https://openrouter.ai/keys

# Required — server-side only. Do not prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Optional — model id from OpenRouter. Defaults to openrouter/auto.
# Examples: openai/gpt-4o-mini, anthropic/claude-sonnet-4, openrouter/auto
OPENROUTER_MODEL=openrouter/auto

# Optional — shown to OpenRouter for attribution / rankings.
# Defaults to https://blackforge.agency
OPENROUTER_SITE_URL=https://blackforge.agency

# Optional — app label sent to OpenRouter. Defaults to "BlackForge assistant".
OPENROUTER_APP_NAME=BlackForge assistant
